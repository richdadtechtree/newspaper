# 다운로드한 신문 이미지/PDF를 저장할 폴더.
# 비워두면 프로젝트 안의 data/newspapers/ 폴더를 사용한다.
#
# 구글 드라이브 데스크톱 앱을 사용 중이라면, 그 앱이 동기화하는 폴더 경로를
# 적어두면 다운로드 결과가 자동으로 구글 드라이브에도 올라간다.
# 이 폴더 밑에는 <년-월>/<날짜>/ 형태로 자동 정리된다 (예: 2026-08/2026-08-30/).
#
# 예시 (Mac):
# NEWSPAPER_OUTPUT_DIR=/Users/본인이름/Library/CloudStorage/GoogleDrive-계정/내 드라이브/신문스크랩
NEWSPAPER_OUTPUT_DIR=

# Playwright가 사용할 브라우저.
# 기본값 "chrome"은 시스템에 설치된 실제 Google Chrome을 사용한다 (Mac 등 대부분 환경 권장).
# Google Chrome이 없는 환경(예: ARM 리눅스 서버)에서는 빈 값으로 두면 Playwright
# 내장 Chromium을 사용한다. 이 경우 먼저 `playwright install chromium`을 실행해야 한다.
PLAYWRIGHT_BROWSER_CHANNEL=chrome

# (화면 없는 서버 전용) rclone으로 구글 드라이브에 업로드한 뒤 서버 로컬 파일을
# 삭제해 디스크 용량을 아끼려면 설정한다. 비워두면 로컬(NEWSPAPER_OUTPUT_DIR)에만
# 저장하고 업로드하지 않는다.
#
# 값 형식: <rclone remote 이름>:<드라이브 안의 폴더 경로>
# 사전 준비: `rclone config`로 "gdrive" 같은 이름의 Google Drive remote를 먼저
# 만들어둬야 한다 (README 참고).
#
# 예시: RCLONE_REMOTE=gdrive:신문스크랩
RCLONE_REMOTE=
